generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  CASHIER
  ADMIN
  STORE_ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum CouponStatus {
  ACTIVE
  WINNER
  REDEEMED
  EXPIRED
  STORE_CLAIMABLE
  STORE_REDEEMED
}

enum CouponBatchStatus {
  OPEN
  DRAWN
}

enum RoundStatus {
  SCHEDULED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum LedgerEntryType {
  DEPOSIT
  PURCHASE_DEBIT
  PRIZE_CREDIT
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAID
  REFUND
  ADJUSTMENT
}

enum NumericPrizePayoutChannel {
  PLATFORM_PIX
  CASHIER_CASH
}

enum PrizePaymentRequestStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}


enum StoreBillingStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum CouponPayoutKind {
  CUSTOMER_REDEMPTION
  STORE_EXPIRED_CLAIM
}

enum CouponPayoutMethod {
  GOODS
  PIX
}

enum CouponPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  UNKNOWN
}

enum PrintJobPurpose {
  AUTO_RECEIPT
  MANUAL_REPRINT
}

enum PrintJobStatus {
  RESERVED
  SENDING
  SENT
  FAILED
  UNKNOWN
}

model User {
  id                    String        @id @default(cuid())
  username              String        @unique
  fullName              String?
  whatsapp              String?
  city                  String?
  address               String?
  referencePoint        String?
  suppliesMaterial      Boolean       @default(false)
  commissionRateBasisPoints Int       @default(0)
  storeId               String?
  store                 Store?        @relation("StoreMembers", fields: [storeId], references: [id], onDelete: SetNull)
  administeredStore     Store?        @relation("StoreAdministrator")
  passwordHash          String
  role                  UserRole      @default(PLAYER)
  status                AccountStatus @default(ACTIVE)
  mustChangePassword    Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  sessions              Session[]
  purchasesAsPlayer     Purchase[]    @relation("PlayerPurchases")
  purchasesAsCashier    Purchase[]    @relation("CashierPurchases")
  ledgerEntries         LedgerEntry[]
  withdrawals           Withdrawal[]  @relation("WithdrawalOwner")
  reviewedWithdrawals   Withdrawal[]  @relation("WithdrawalReviewer")
  auditEvents           AuditEvent[]  @relation("AuditActor")
  settingsChanged       SettingChange[] @relation("SettingChanger")
  commissions           CashierCommission[]
  customersCreated      Customer[]              @relation("CustomerCreator")
  withdrawalHistoryActions WithdrawalStatusHistory[] @relation("WithdrawalHistoryActor")
  cashierSettlementsAsCashier CashierSettlement[] @relation("CashierSettlementCashier")
  cashierSettlementsCreated CashierSettlement[] @relation("CashierSettlementAdmin")
  numericPrizePayoutsCreated NumericPrizePayout[] @relation("NumericPrizePayoutActor")
  numericPrizePayoutsAsCashier NumericPrizePayout[] @relation("NumericPrizePayoutCashier")
  printJobsRequested PrintJob[] @relation("PrintJobRequester")
  prizePaymentRequestsReviewed PrizePaymentRequest[] @relation("PrizePaymentRequestReviewer")
  prizePaymentBatchesReviewed PrizePaymentBatch[] @relation("PrizePaymentBatchReviewer")
  issuedCoupons          Coupon[] @relation("CouponIssuer")
  storeClaimedCoupons     Coupon[] @relation("CouponStoreClaimer")
  couponPayoutsRequested  CouponPayout[] @relation("CouponPayoutRequester")

  @@index([role, status])
}

model Store {
  id                       String        @id @default(cuid())
  name                     String
  status                   AccountStatus @default(ACTIVE)
  commissionRateBasisPoints Int
  couponLimit              Int           @default(100)
  outstandingCouponCount   Int           @default(0)
  adminUserId              String        @unique
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  adminUser                User          @relation("StoreAdministrator", fields: [adminUserId], references: [id], onDelete: Restrict)
  users                    User[]        @relation("StoreMembers")
  coupons                  Coupon[]
  billings                 StoreBilling[]
  payoutOperations         CouponPayout[]
  pixKey                   StorePixKey?

  @@index([status, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchases   Purchase[]
  createdBy   User?    @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([phone])
  @@index([createdAt])
}

model Round {
  id              String                   @id @default(cuid())
  code            String                   @unique
  startsAt        DateTime
  cutoffAt        DateTime
  resultAt        DateTime
  status          RoundStatus               @default(SCHEDULED)
  /// Six-digit result for numeric rounds, stored as text to preserve leading zeroes.
  resultNumber    String?
  resultPublishedAt DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  participations  PurchaseParticipation[]

  @@index([status, startsAt])
  @@index([resultAt])
  @@index([resultPublishedAt])
  @@index([cutoffAt, status])
}

model Purchase {
  id                String        @id @default(cuid())
  playerId          String?
  cashierId         String?
  customerId        String?
  status            PurchaseStatus @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethod
  totalCents        Int
  currency          String        @default("BRL")
  receiptCode       String?       @unique
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?
  player            User?         @relation("PlayerPurchases", fields: [playerId], references: [id], onDelete: Restrict)
  cashier           User?         @relation("CashierPurchases", fields: [cashierId], references: [id], onDelete: Restrict)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  participations    PurchaseParticipation[]
  numericIntent     NumericPurchaseIntent?
  payment           Payment?
  ledgerEntries     LedgerEntry[]
  commission        CashierCommission?
  printJobs         PrintJob[]
  prizePaymentRequests PrizePaymentRequest[]
  prizePaymentBatches PrizePaymentBatch[]

  @@index([playerId, createdAt])
  @@index([cashierId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([status, paymentMethod, id])
}

model NumericPurchaseIntent {
  id           String   @id @default(cuid())
  purchaseId   String   @unique
  roundCount   Int
  numbers      Json
  allocation   Json
  ruleVersion  String
  ruleSnapshot Json
  createdAt    DateTime @default(now())
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
}

model PurchaseParticipation {
  id             String              @id @default(cuid())
  purchaseId     String
  roundId        String
  status         ParticipationStatus @default(PENDING)
  totalCents     Int
  createdAt      DateTime            @default(now())
  confirmedAt    DateTime?
  purchase       Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  round          Round               @relation(fields: [roundId], references: [id], onDelete: Restrict)
  numericLines   NumericParticipationLine[]
  ledgerEntries  LedgerEntry[]

  @@unique([purchaseId, roundId])
  @@index([roundId, status, createdAt])
  @@index([purchaseId, status])
}

model NumericParticipationLine {
  id               String   @id @default(cuid())
  participationId  String
  numberValue      String
  tensCents        Int
  hundredsCents    Int
  milharCents      Int
  quinaCents       Int
  senaCents        Int
  ruleVersion      String
  ruleSnapshot     Json
  prizeCents       Int?
  prizeCreditedAt  DateTime?
  prizeExpiredAt   DateTime?
  prizeExpiryReviewedAt DateTime?
  createdAt        DateTime @default(now())
  participation    PurchaseParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  prizePayout      NumericPrizePayout?
  prizePaymentRequest PrizePaymentRequest?
  prizePaymentBatchItems PrizePaymentBatchItem[]

  @@index([numberValue])
  @@index([participationId])
  @@index([prizeExpiredAt])
  @@index([prizeExpiryReviewedAt])
}

model Payment {
  id                    String        @id @default(cuid())
  purchaseId            String        @unique
  provider              String
  providerPaymentId     String?
  providerQrCodeId      String? @unique
  pixCopyPaste           String?
  pixQrCodeBase64        String?
  pixTicketUrl           String?
  providerStatus         String?
  providerStatusDetail   String?
  idempotencyKey        String        @unique
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  confirmedAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  purchase              Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  webhookEvents         WebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([status, createdAt])
  @@index([provider, status, updatedAt, createdAt])
}

model WebhookEvent {
  id                String   @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  payloadDigest     String
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  processingError   String?
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  userId           String
  purchaseId       String?
  participationId  String?
  withdrawalId     String?
  type             LedgerEntryType
  amountCents      Int
  currency         String          @default("BRL")
  idempotencyKey   String          @unique
  description      String
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase         Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  participation    PurchaseParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)
  withdrawal       Withdrawal?     @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([purchaseId])
  @@index([participationId])
  @@index([withdrawalId])
}

model CashierCommission {
  id                    String   @id @default(cuid())
  purchaseId            String   @unique
  cashierId             String
  rateBasisPoints       Int
  amountCents           Int
  createdAt             DateTime @default(now())
  purchase              Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  cashier               User     @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  @@index([cashierId, createdAt])
}

model CashierSettlement {
  id                    String   @id @default(cuid())
  cashierId             String
  adminId               String
  settledAt             DateTime @default(now())
  cashSalesCents        Int
  pixSalesCents         Int
  totalSalesCents       Int
  salesCount            Int
  gamesCount            Int      @default(0)
  commissionCents       Int
  cashPrizePayoutCount  Int      @default(0)
  cashPrizePayoutCents  Int      @default(0)
  pendingCashSalesCount Int      @default(0)
  pendingCashSalesCents Int      @default(0)
  cashier               User     @relation("CashierSettlementCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  admin                 User     @relation("CashierSettlementAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  cashPrizePayouts      NumericPrizePayout[]

  @@index([cashierId, settledAt])
  @@index([adminId, settledAt])
}

model NumericPrizePayout {
  id                   String                    @id @default(cuid())
  participationLineId String                    @unique
  channel              NumericPrizePayoutChannel
  amountCents          Int
  actorId              String?
  cashierId            String?
  settlementId         String?
  reference            String?
  paidAt               DateTime                  @default(now())
  participationLine    NumericParticipationLine  @relation(fields: [participationLineId], references: [id], onDelete: Restrict)
  actor                User?                     @relation("NumericPrizePayoutActor", fields: [actorId], references: [id], onDelete: Restrict)
  cashier              User?                     @relation("NumericPrizePayoutCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  settlement           CashierSettlement?        @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([cashierId, paidAt])
  @@index([settlementId])
}

model Withdrawal {
  id                  String                 @id @default(cuid())
  userId              String
  amountCents         Int
  pixKey              String?
  pixKeyEncrypted     String? // legado: ciphertext de saques anteriores
  pixKeyType          String?
  holderName          String?
  holderNameEncrypted String? // legado
  holderCpfEncrypted  String? // legado
  holderCpfMasked     String?
  pixKeyMasked        String?
  paymentReference    String?                @unique
  providerTransferId     String?                @unique
  providerTransferStatus String?
  providerTransferFailureReason String?
  transferRequestedAt DateTime?
  status              WithdrawalStatus       @default(PENDING)
  idempotencyKey      String                 @unique
  reviewedById        String?
  providerRef         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy          User?                  @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  statusHistory       WithdrawalStatusHistory[]
  ledgerEntries       LedgerEntry[]

  @@index([userId, status, createdAt])
  @@index([reviewedById, updatedAt])
}

model WithdrawalStatusHistory {
  id            String           @id @default(cuid())
  withdrawalId  String
  fromStatus    WithdrawalStatus?
  toStatus      WithdrawalStatus
  actorId       String?
  note          String?
  createdAt     DateTime         @default(now())
  withdrawal    Withdrawal      @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  actor         User?            @relation("WithdrawalHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([withdrawalId, createdAt])
}

model Setting {
  key        String   @id
  value      String
  updatedAt  DateTime @updatedAt
  changes    SettingChange[]
}

model SettingChange {
  id           String   @id @default(cuid())
  settingKey   String
  oldValue     String?
  newValue     String
  changedById  String
  changedAt    DateTime @default(now())
  setting      Setting  @relation(fields: [settingKey], references: [key], onDelete: Restrict)
  changedBy    User     @relation("SettingChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([settingKey, changedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}


model LoginAttemptBucket {
  keyHash         String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
  @@index([windowStartedAt])
}

model PrintJob {
  id             String          @id @default(cuid())
  purchaseId     String
  purpose        PrintJobPurpose
  /// For AUTO_RECEIPT, equals purchaseId; unique nullable key permits unlimited audited manual reprints.
  autoReceiptKey String?         @unique
  status         PrintJobStatus  @default(RESERVED)
  requestedById  String?
  deviceName     String?
  errorCode      String?
  reservedAt     DateTime        @default(now())
  sendingAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchase       Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  requestedBy    User?           @relation("PrintJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([purchaseId, createdAt])
  @@index([status, updatedAt])
  @@index([requestedById, createdAt])
}


model PrizePaymentRequest {
  id                     String   @id @default(cuid())
  participationLineId    String   @unique
  purchaseId             String
  batchId                String?
  pixKey                 String?
  pixKeyEncrypted        String? // legado: solicitações criadas antes da remoção da criptografia
  pixKeyMasked           String
  pixKeyType             String?
  holderName             String?
  holderNameEncrypted    String? // legado
  holderCpfEncrypted     String? // legado
  holderCpfMasked        String?
  grossCents             Int
  administrativeFeeCents Int      @default(0)
  transactionFeeCents    Int      @default(0)
  netCents               Int
  feeRuleVersion         String
  status                 PrizePaymentRequestStatus @default(PENDING)
  requestedAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt
  reviewedAt             DateTime?
  reviewerId             String?
  paymentReference       String?
  providerTransferId        String? @unique
  providerTransferStatus    String?
  providerTransferReceiptUrl String?
  providerTransferFailureReason String?
  transferRequestedAt   DateTime?
  note                   String?
  participationLine      NumericParticipationLine @relation(fields: [participationLineId], references: [id], onDelete: Restrict)
  purchase               Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  batch                  PrizePaymentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  reviewer               User? @relation("PrizePaymentRequestReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([purchaseId, requestedAt])
  @@index([reviewerId, reviewedAt])
  @@index([batchId, status])
}

model PrizePaymentBatch {
  id                       String   @id @default(cuid())
  purchaseId               String
  pixKey                   String?
  pixKeyEncrypted          String? // legado
  pixKeyMasked             String
  pixKeyType               String
  holderName               String?
  holderNameEncrypted      String? // legado
  holderCpfEncrypted       String? // legado
  holderCpfMasked          String
  grossCents               Int
  administrativeFeeCents   Int      @default(0)
  transactionFeeCents      Int      @default(0)
  netCents                 Int
  feeRuleVersion           String
  status                   PrizePaymentRequestStatus @default(PENDING)
  requestedAt              DateTime @default(now())
  reviewedAt               DateTime?
  reviewerId               String?
  paymentReference         String?  @unique
  providerTransferId          String?  @unique
  providerTransferStatus      String?
  providerTransferReceiptUrl  String?
  providerTransferFailureReason String?
  transferRequestedAt      DateTime?
  purchase                 Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  reviewer                 User? @relation("PrizePaymentBatchReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  requests                 PrizePaymentRequest[]
  items                    PrizePaymentBatchItem[]

  @@index([purchaseId, requestedAt])
  @@index([status, requestedAt])
}

model PrizePaymentBatchItem {
  id               String   @id @default(cuid())
  batchId          String
  participationLineId String
  amountCents      Int
  batch            PrizePaymentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  participationLine NumericParticipationLine @relation(fields: [participationLineId], references: [id], onDelete: Restrict)

  @@unique([batchId, participationLineId])
  @@index([batchId])
}


model CouponQueueState {
  id                    String   @id
  currentBatchId        String?
  currentBatchSequence  Int
  currentBatchCount     Int      @default(0)
  nextBatchSequence     Int
  updatedAt             DateTime @updatedAt
}

model CouponBatch {
  id             String            @id @default(cuid())
  sequenceNumber Int               @unique
  status         CouponBatchStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  winnerCouponId String?           @unique
  coupons        Coupon[]          @relation("CouponBatchMembers")
  winnerCoupon   Coupon?           @relation("CouponBatchWinner", fields: [winnerCouponId], references: [id], onDelete: Restrict)

  @@index([status, sequenceNumber])
}

model Coupon {
  id                         String       @id @default(cuid())
  publicCode                 String       @unique
  idempotencyKey             String       @unique
  storeId                    String
  issuedById                 String
  batchId                    String
  purchaseAmountCents        Int
  commissionRateBasisPoints  Int
  platformFeeCents           Int
  status                     CouponStatus @default(ACTIVE)
  issuedAt                   DateTime     @default(now())
  drawnAt                    DateTime?
  customerRedemptionDeadline DateTime?
  redeemedAt                 DateTime?
  storeClaimedAt             DateTime?
  storeClaimedById           String?
  store                      Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  issuedBy                   User         @relation("CouponIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  storeClaimedBy             User?        @relation("CouponStoreClaimer", fields: [storeClaimedById], references: [id], onDelete: Restrict)
  batch                      CouponBatch  @relation("CouponBatchMembers", fields: [batchId], references: [id], onDelete: Restrict)
  winningBatch               CouponBatch? @relation("CouponBatchWinner")
  payout                      CouponPayout?
  billingLinks                StoreBillingCoupon[]

  @@index([storeId, issuedAt])
  @@index([issuedById, issuedAt])
  @@index([batchId, issuedAt])
  @@index([status, issuedAt])
  @@index([status, customerRedemptionDeadline])
  @@index([storeClaimedById, storeClaimedAt])
}


model StoreBilling {
  id                 String             @id @default(cuid())
  storeId            String
  periodKey          String
  amountCents        Int
  status             StoreBillingStatus @default(PENDING)
  idempotencyKey     String             @unique
  externalReference  String             @unique
  provider           String             @default("ASAAS")
  providerPaymentId  String?            @unique
  providerQrCodeId   String?            @unique
  pixCopyPaste       String?
  pixQrCodeBase64    String?
  dueAt              DateTime?
  paidAt             DateTime?
  lastProviderStatus String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  couponLinks        StoreBillingCoupon[]

  @@unique([storeId, periodKey])
  @@index([storeId, status, createdAt])
  @@index([status, updatedAt])
}

model StoreBillingCoupon {
  id        String       @id @default(cuid())
  billingId String
  couponId  String       @unique
  createdAt DateTime     @default(now())
  billing   StoreBilling @relation(fields: [billingId], references: [id], onDelete: Restrict)
  coupon    Coupon       @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([billingId, couponId])
  @@index([billingId, createdAt])
}

model CouponPayout {
  id                    String             @id @default(cuid())
  couponId              String             @unique
  storeId               String
  requestedById         String?
  kind                  CouponPayoutKind
  method                CouponPayoutMethod?
  status                CouponPayoutStatus @default(PENDING)
  amountCents           Int
  idempotencyKey        String             @unique
  externalReference     String             @unique
  provider              String?
  providerTransferId    String?            @unique
  providerStatus        String?
  providerReceiptUrl    String?
  providerFailureReason String?
  pixKeyCiphertext      String?
  pixKeyMasked          String?
  pixKeyType            String?
  requestedAt           DateTime?
  paidAt                DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  coupon                Coupon             @relation(fields: [couponId], references: [id], onDelete: Restrict)
  store                 Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  requestedBy           User?              @relation("CouponPayoutRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([storeId, kind, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([status, updatedAt])
}

model StorePixKey {
  id            String   @id @default(cuid())
  storeId       String   @unique
  keyCiphertext String
  keyMasked     String
  keyType       String
  validatedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
}

model AsaasWebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  eventType       String
  payloadDigest   String
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  processingError String?

  @@index([processedAt, receivedAt])
}
