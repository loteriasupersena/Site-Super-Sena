generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ESTABLISHMENT_STAFF
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum EstablishmentStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SaleStatus {
  RECORDED
  CANCELLED
}

enum CouponStatus {
  ACTIVE
  REDEEMED
  CANCELLED
  EXPIRED
}

enum DrawStatus {
  SCHEDULED
  OPEN
  CLOSED
  PUBLISHED
  CANCELLED
}

enum AwardStatus {
  AVAILABLE
  RESERVED
  REDEEMED
  CANCELLED
  EXPIRED
}

enum RedemptionStatus {
  INITIATED
  CONFIRMED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum LedgerEntryType {
  SALE_CONTRIBUTION
  ESTABLISHMENT_PAYOUT
  PAYOUT_REVERSAL
  MANUAL_ADJUSTMENT
}

enum PrintJobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  UNKNOWN
}

model User {
  id                 String        @id @default(cuid())
  username           String        @unique
  fullName           String
  passwordHash       String
  role               UserRole      @default(ESTABLISHMENT_STAFF)
  status             AccountStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(false)
  sessions           Session[]
  memberships        EstablishmentUser[]
  salesRecorded      CommercialSale[] @relation("SaleRecorder")
  pixKeysUpdated     Establishment[] @relation("EstablishmentPixUpdater")
  redemptionsConfirmed Redemption[] @relation("RedemptionConfirmer")
  auditEvents        AuditEvent[]  @relation("AuditActor")
  reviewedPayouts    EstablishmentPayout[] @relation("PayoutReviewer")
  printJobs          PrintJob[]    @relation("PrintRequester")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([role, status])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginAttemptBucket {
  keyHash         String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}

model Establishment {
  id                    String              @id @default(cuid())
  code                  String              @unique
  legalName             String
  tradeName             String
  documentNumber        String?             @unique
  phone                 String?
  email                 String?
  postalCode            String?
  street                String?
  streetNumber          String?
  addressComplement     String?
  neighborhood          String?
  city                  String?
  state                 String?
  contributionRateBps   Int
  status                EstablishmentStatus @default(PENDING)
  pixKeyCiphertext      String?
  pixKeyType            String?
  pixKeyMasked          String?
  pixHolderName         String?
  pixHolderDocumentMasked String?
  pixUpdatedAt          DateTime?
  pixUpdatedById        String?
  pixUpdatedBy          User?               @relation("EstablishmentPixUpdater", fields: [pixUpdatedById], references: [id], onDelete: Restrict)
  memberships           EstablishmentUser[]
  sales                 CommercialSale[]
  redemptions           Redemption[]        @relation("RedeemingEstablishment")
  payouts               EstablishmentPayout[]
  ledgerEntries         FinancialLedgerEntry[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, tradeName])
  @@index([city, state])
}

model EstablishmentUser {
  id              String        @id @default(cuid())
  establishmentId String
  userId          String
  isManager       Boolean       @default(false)
  active          Boolean       @default(true)
  establishment  Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@unique([establishmentId, userId])
  @@index([userId, active])
}

model CommercialSale {
  id                    String        @id @default(cuid())
  establishmentId       String
  recordedById           String
  saleAmountCents       Int
  contributionRateBps   Int
  contributionAmountCents Int
  status                SaleStatus    @default(RECORDED)
  idempotencyKey        String        @unique
  recordedAt            DateTime      @default(now())
  cancelledAt           DateTime?
  cancellationReason    String?
  establishment         Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  recordedBy             User          @relation("SaleRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  coupon                Coupon?
  ledgerEntries         FinancialLedgerEntry[]

  @@index([establishmentId, recordedAt])
  @@index([status, recordedAt])
  @@index([recordedById, recordedAt])
}

model Coupon {
  id              String       @id @default(cuid())
  publicCode      String       @unique
  qrTokenHash     String       @unique
  saleId          String       @unique
  status          CouponStatus @default(ACTIVE)
  issuedAt        DateTime     @default(now())
  redeemedAt      DateTime?
  sale            CommercialSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  participation   DrawParticipation?
  award           PrizeAward?
  redemption      Redemption?
  printJobs       PrintJob[]

  @@index([status, issuedAt])
}

model Draw {
  id              String     @id @default(cuid())
  code            String     @unique
  title           String
  scheduledAt     DateTime
  closedAt        DateTime?
  publishedAt     DateTime?
  status          DrawStatus @default(SCHEDULED)
  resultReference String?
  ruleVersion     String
  ruleSnapshot    Json
  participations  DrawParticipation[]
  awards          PrizeAward[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, scheduledAt])
}

model DrawParticipation {
  id             String   @id @default(cuid())
  drawId         String
  couponId       String   @unique
  internalNumber String
  createdAt      DateTime @default(now())
  draw           Draw     @relation(fields: [drawId], references: [id], onDelete: Restrict)
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([drawId, internalNumber])
  @@index([drawId, createdAt])
}

model PrizeAward {
  id              String      @id @default(cuid())
  drawId          String
  couponId        String      @unique
  amountCents     Int
  status          AwardStatus @default(AVAILABLE)
  determinedAt   DateTime    @default(now())
  expiresAt       DateTime?
  draw            Draw        @relation(fields: [drawId], references: [id], onDelete: Restrict)
  coupon          Coupon      @relation(fields: [couponId], references: [id], onDelete: Restrict)
  redemption      Redemption?

  @@index([drawId, status])
  @@index([status, determinedAt])
}

model Redemption {
  id                       String        @id @default(cuid())
  awardId                  String        @unique
  couponId                 String        @unique
  redeemingEstablishmentId String
  confirmedById            String
  status                   RedemptionStatus @default(INITIATED)
  amountCents              Int
  idempotencyKey           String        @unique
  initiatedAt              DateTime      @default(now())
  confirmedAt              DateTime?
  award                    PrizeAward    @relation(fields: [awardId], references: [id], onDelete: Restrict)
  confirmedBy              User          @relation("RedemptionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  coupon                   Coupon        @relation(fields: [couponId], references: [id], onDelete: Restrict)
  redeemingEstablishment   Establishment @relation("RedeemingEstablishment", fields: [redeemingEstablishmentId], references: [id], onDelete: Restrict)
  payout                   EstablishmentPayout?

  @@index([redeemingEstablishmentId, initiatedAt])
  @@index([status, initiatedAt])
}

model EstablishmentPayout {
  id                       String       @id @default(cuid())
  redemptionId             String       @unique
  establishmentId          String
  amountCents              Int
  currency                 String       @default("BRL")
  status                   PayoutStatus @default(PENDING)
  provider                 String?
  providerTransferId       String?      @unique
  providerReference        String       @unique
  providerStatus           String?
  failureReason            String?
  requestedAt              DateTime     @default(now())
  paidAt                   DateTime?
  reviewedById             String?
  redemption               Redemption   @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  establishment            Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  reviewedBy               User?        @relation("PayoutReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  ledgerEntry              FinancialLedgerEntry?

  @@index([establishmentId, status, requestedAt])
  @@index([status, requestedAt])
}

model ProviderEvent {
  id                String              @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  payloadDigest     String
  status            ProviderEventStatus @default(RECEIVED)
  receivedAt        DateTime            @default(now())
  processedAt       DateTime?
  processingError   String?
  relatedReference  String?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

model FinancialLedgerEntry {
  id               String          @id @default(cuid())
  establishmentId  String
  saleId           String?
  payoutId         String?         @unique
  type             LedgerEntryType
  amountCents      Int
  currency         String          @default("BRL")
  idempotencyKey   String          @unique
  description      String
  createdAt        DateTime        @default(now())
  establishment    Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  sale             CommercialSale? @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payout           EstablishmentPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([establishmentId, createdAt])
  @@index([saleId])
  @@index([type, createdAt])
}

model PrintJob {
  id            String         @id @default(cuid())
  couponId      String
  requestedById String?
  status        PrintJobStatus @default(QUEUED)
  deviceName    String?
  errorCode     String?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
  coupon        Coupon         @relation(fields: [couponId], references: [id], onDelete: Restrict)
  requestedBy   User?          @relation("PrintRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([couponId, createdAt])
  @@index([status, createdAt])
}

model Setting {
  key        String   @id
  value      Json
  updatedAt  DateTime @updatedAt
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
