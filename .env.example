# Never place real credentials in this file.
# AquaCloud/Hydro supplies the runtime container and PostgreSQL connection.
# URL-encode reserved characters in USER and PASSWORD (for example @ as %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
AUTH_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=https://loteriasupersena.com.br
NEXT_PUBLIC_SITE_URL=https://loteriasupersena.com.br

# Internal Node worker runs in this same application container.
# Required: generate independent secrets (at least 32 characters), e.g. openssl rand -hex 32.
# The worker reconciles Mercado Pago Pix payments and schedules rounds every minute.
# MERCADOPAGO_RECONCILIATION_TOKEN=replace-with-a-random-secret
# ROUND_SCHEDULER_SECRET=replace-with-a-different-random-secret

# Mercado Pago production credentials. Never commit real credentials here.
# Required: production Access Token from Mercado Pago Developers.
# MERCADOPAGO_ACCESS_TOKEN=
# Required: webhook signing secret configured for the Orders notification.
# MERCADOPAGO_WEBHOOK_SECRET=
# Optional: domain used only for synthetic payer emails (not player contact email).
# MERCADOPAGO_PAYER_EMAIL_DOMAIN=superquina.com
#
# After deployment, register this URL in Mercado Pago Developers:
# https://loteriasupersena.com.br/api/payments/mercadopago/webhook
# Enable Order notifications (Orders API). The webhook fetches the order from
# Mercado Pago before any payment is confirmed; do not treat the notification
# body itself as proof of payment.

# One-time admin bootstrap inputs only; inject temporarily for the command and remove afterward.
# ADMIN_USERNAME=
# ADMIN_INITIAL_PASSWORD=
# CONFIRM_ADMIN_PROVISIONING=CREATE_FIRST_ADMIN

# Official Super Sena website and prize-redemption support contact.
# WhatsApp digits only, including country code and area code.
NEXT_PUBLIC_PRIZE_SUPPORT_WHATSAPP=5577991601217
