# Banco local EXCLUSIVO da nova plataforma. Nunca use a URL do banco anterior.
# Crie um PostgreSQL novo e vazio no provedor antes de preencher esta variável.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/NEW_EMPTY_DATABASE?schema=public
DATABASE_PURPOSE=benefits-platform-empty
AUTH_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Credenciais de integração serão adicionadas quando os módulos forem implementados.
# PIX_PROVIDER=
# PIX_PROVIDER_ACCESS_TOKEN=
# PIX_PROVIDER_WEBHOOK_SECRET=
