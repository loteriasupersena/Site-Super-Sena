# Never place real credentials in this file.
# AquaCloud/Hydro must provide a valid PostgreSQL connection URL.
# URL-encode reserved characters in USER and PASSWORD (for example @ as %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
AUTH_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=https://loteriasupersena.com.br
NEXT_PUBLIC_SITE_URL=https://loteriasupersena.com.br

# Configure a random secret and call /api/internal/round-scheduler every minute with Authorization: Bearer <ROUND_SCHEDULER_SECRET>.
# The scheduler maintains up to 48 upcoming rounds across the next 24 hours at 30-minute intervals and processes Pix, opening, closing, draw and prize-settlement events.
# ROUND_SCHEDULER_SECRET=replace-with-a-long-random-secret

# Asaas production API. Never commit real credentials or webhook tokens to this file.
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api.asaas.com/v3
# ASAAS_ENVIRONMENT=production
# ASAAS_WEBHOOK_TOKEN=use-a-separate-random-token-of-32-to-255-characters
# Configure the Asaas payment webhook at:
# https://loteriasupersena.com.br/api/payments/asaas/webhook
# Select PAYMENT_RECEIVED and PAYMENT_CONFIRMED (and PAYMENT_REFUNDED for alerts).
# Configure the Asaas transfer webhook separately at:
# https://loteriasupersena.com.br/api/payments/asaas/transfers/webhook
# Select TRANSFER_CREATED, TRANSFER_PENDING, TRANSFER_IN_BANK_PROCESSING,
# TRANSFER_BLOCKED, TRANSFER_DONE, TRANSFER_FAILED and TRANSFER_CANCELLED.


# Encrypts Pix keys saved with withdrawal requests. Generate 32 random bytes and provide as 64 hex chars or base64; keep stable across restarts and never commit the real key.
# WALLET_PIX_ENCRYPTION_KEY=replace-with-32-random-bytes-in-hex-or-base64

# One-time admin bootstrap inputs only; inject temporarily for the command and remove afterward.
# ADMIN_USERNAME=
# ADMIN_INITIAL_PASSWORD=
# CONFIRM_ADMIN_PROVISIONING=CREATE_FIRST_ADMIN

# Official Super Sena website and prize-redemption support contact.
# WhatsApp digits only, including country code and area code.
NEXT_PUBLIC_PRIZE_SUPPORT_WHATSAPP=5577991601217

# Chave Pix cadastrada na conta Asaas (não inserir chave real no repositório)
ASAAS_PIX_KEY=
